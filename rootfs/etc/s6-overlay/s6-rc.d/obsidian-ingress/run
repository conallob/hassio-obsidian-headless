#!/usr/bin/with-contenv bashio
# s6 service: obsidian-ingress
# Runs the HA ingress reverse proxy on port 8423 → vault-mcp on 8420.
# Serves the MCP endpoint at /obsidian/mcp via HA's built-in ingress panel.

. /usr/local/bin/build-env.sh

if [ "${ENABLE_INGRESS}" != "true" ]; then
    bashio::log.info "HA ingress disabled (enable_ingress: false). Idling."
    exec sleep inf
fi

if [ "${ENABLE_MCP}" != "true" ]; then
    bashio::log.fatal "enable_ingress requires enable_mcp: true."
    exec sleep inf
fi

# Ingress is reachable from outside the local network via HA's reverse proxy.
# Unauthenticated access is not acceptable — require bearer token or OAuth.
if [ -z "${VAULT_MCP_TOKEN}" ] && [ -z "${VAULT_OAUTH_CLIENT_SECRET}" ]; then
    bashio::log.fatal "HA ingress requires mcp_auth_token or oauth_client_secret. Set at least one."
    exec sleep inf
fi

bashio::log.info "Starting HA ingress proxy: /obsidian/mcp → MCP server :8420"
exec node /usr/local/bin/ingress-proxy.js
