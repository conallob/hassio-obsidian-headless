#!/usr/bin/with-contenv bashio
# s6 service: remarkable-sync
# Always starts the binary so the Obsidian token generator (port 8422) and
# reMarkable registration UI (port 8421) are available from first boot.
# The sync loop only runs when enable_remarkable is true.

. /usr/local/bin/build-env.sh

# Pass enable_remarkable into the binary so it can skip the sync loop.
if bashio::config.true "enable_remarkable"; then
    export REMARKABLE_SYNC_ENABLED="true"

    # bashio::config prints the literal string "null" (not empty) for an
    # unset str?/password? option — guard with has_value so
    # REMARKABLE_DEVICE_TOKEN stays genuinely unset when the option isn't
    # configured. Without this, main.go's env(key, "") sees the non-empty
    # string "null" and never falls back to reading the saved token file
    # from the browser-based registration UI, so pairing via port 8421
    # appeared to work but the sync loop kept using "null" as the token
    # forever (HTTP 401: invalid Authorization header).
    if bashio::config.has_value "remarkable_device_token"; then
        export REMARKABLE_DEVICE_TOKEN="$(bashio::config 'remarkable_device_token')"
    fi

    REMARKABLE_OUTPUT_DIR="$(bashio::config 'remarkable_output_dir')"
    export REMARKABLE_OUTPUT_DIR="${REMARKABLE_OUTPUT_DIR:-reMarkable}"

    if bashio::config.has_value "ha_ocr_url"; then
        export HA_OCR_URL="$(bashio::config 'ha_ocr_url')"
    fi
    if bashio::config.has_value "ha_ocr_token"; then
        export HA_OCR_TOKEN="$(bashio::config 'ha_ocr_token')"
    fi
    if bashio::config.has_value "ha_ocr_entity"; then
        export HA_OCR_ENTITY="$(bashio::config 'ha_ocr_entity')"
    fi

    export SYNC_INTERVAL="$(bashio::config 'remarkable_sync_interval' 2>/dev/null || echo 300)"
    bashio::log.info "reMarkable sync enabled (interval: ${SYNC_INTERVAL}s)"
else
    export REMARKABLE_SYNC_ENABLED="false"
    bashio::log.info "reMarkable sync disabled — web UIs still available"
fi

export VAULT_PATH="${VAULT_PATH:-/share/obsidian-vault}"
export REMARKABLE_REGISTER_PORT="8421"
export OBSIDIAN_AUTH_PORT="8422"

bashio::log.info "Obsidian token generator: http://<ha-host>:8422/"
bashio::log.info "reMarkable registration:   http://<ha-host>:8421/"
exec /usr/local/bin/remarkable-sync
