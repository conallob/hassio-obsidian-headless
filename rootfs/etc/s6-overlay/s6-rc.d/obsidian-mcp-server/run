#!/usr/bin/with-contenv bashio
# s6 service: obsidian-mcp
# Runs obsidian-vault-mcp HTTP server, with optional Tailscale or Cloudflare
# Tunnel exposure (cloudflare mode is config/validation-only — the actual
# tunnel client runs in the separate cloudflared add-on).
# Exits cleanly (oneshot-style) when enable_mcp is false so s6 does not restart it.

. /usr/local/bin/build-env.sh

if [ "${ENABLE_MCP}" != "true" ]; then
    bashio::log.info "MCP server disabled (enable_mcp: false). Idling."
    exec sleep inf
fi

bashio::log.info "Starting Obsidian MCP server (tunnel: ${TUNNEL_MODE})"

# --- Validate allowed-hosts config ---
# obsidian-vault-mcp's Host-header allowlist matches the incoming Host
# header by exact string (only "127.0.0.1"/"localhost"/"[::1]" are allowed
# unconditionally) -- any external tunnel_mode needs mcp_allowed_hosts set
# to the actual hostname clients will connect with, or every request gets
# rejected with "Invalid Host header" regardless of auth being otherwise
# correct.
if [ "${TUNNEL_MODE}" != "none" ] && [ -z "${VAULT_MCP_ALLOWED_HOSTS}" ]; then
    bashio::log.warning "mcp_allowed_hosts is empty -- requests via any hostname other than 127.0.0.1/localhost will be rejected with 'Invalid Host header'. Set it to the hostname clients actually connect with (e.g. your Cloudflare Tunnel or Tailscale hostname)."
fi

# --- Validate auth config ---
# obsidian-vault-mcp's own auth middleware unconditionally requires
# VAULT_MCP_TOKEN to be set (it 500s on every request with "Server
# misconfigured: no auth token set" otherwise) -- VAULT_OAUTH_CLIENT_ID/SECRET
# only configure an *additional* client_credentials grant layered on top of
# the bearer check, never a substitute for it. mcp_auth_token is therefore a
# hard requirement below for every mode except "none" (trusted local network
# only, soft warning) and native Cloudflare Access mode (see next paragraph).
#
# tunnel_mode: tailscale additionally requires oauth_client_secret (real
# OAuth 2.1, not just the shared bearer secret) since Tailscale only proves
# network membership, not identity; pair it with Tailscale's own
# identity-aware ACLs for real per-user auth.
#
# tunnel_mode: cloudflare has two paths. Set cf_access_team_domain AND
# cf_access_aud (both-or-neither) and obsidian-vault-mcp validates Cloudflare
# Access's own JWT directly -- its bearer/OAuth routes aren't even mounted in
# that mode, so neither mcp_auth_token nor oauth_client_secret is needed.
# Without both of those, it falls back to requiring mcp_auth_token +
# oauth_client_secret same as tailscale, since Cloudflare Tunnel traffic
# alone only proves it passed through the tunnel, not who the caller is.
case "${TUNNEL_MODE}" in
    cloudflare)
        if [ -n "${VAULT_MCP_CF_ACCESS_TEAM_DOMAIN}" ] || [ -n "${VAULT_MCP_CF_ACCESS_AUD}" ]; then
            if [ -z "${VAULT_MCP_CF_ACCESS_TEAM_DOMAIN}" ] || [ -z "${VAULT_MCP_CF_ACCESS_AUD}" ]; then
                bashio::log.fatal "Set both cf_access_team_domain and cf_access_aud, or neither."
                exec sleep inf
            fi
            bashio::log.info "Cloudflare Access mode: obsidian-vault-mcp validates Access JWTs directly (team: ${VAULT_MCP_CF_ACCESS_TEAM_DOMAIN}). mcp_auth_token/oauth_client_secret not required."
        elif [ -z "${VAULT_MCP_TOKEN}" ]; then
            bashio::log.fatal "mcp_auth_token is required when tunnel_mode is 'cloudflare' (unless cf_access_team_domain and cf_access_aud are both set)."
            exec sleep inf
        elif [ -z "${VAULT_OAUTH_CLIENT_SECRET}" ]; then
            bashio::log.fatal "oauth_client_secret is also required when tunnel_mode is 'cloudflare' without cf_access_team_domain/cf_access_aud."
            exec sleep inf
        fi
        ;;
    tailscale)
        if [ -z "${VAULT_MCP_TOKEN}" ]; then
            bashio::log.fatal "mcp_auth_token is required when tunnel_mode is 'tailscale'."
            exec sleep inf
        fi
        if [ -z "${VAULT_OAUTH_CLIENT_SECRET}" ]; then
            bashio::log.fatal "oauth_client_secret is also required when tunnel_mode is 'tailscale' — Tailscale only proves network membership, not identity."
            exec sleep inf
        fi
        ;;
    https)
        if [ -z "${VAULT_MCP_TOKEN}" ]; then
            bashio::log.fatal "mcp_auth_token is required when tunnel_mode is 'https'."
            exec sleep inf
        fi
        ;;
    *)
        if [ -z "${VAULT_MCP_TOKEN}" ]; then
            bashio::log.warning "No MCP auth configured — port 8420 is unauthenticated. Only safe on a trusted local network."
        fi
        ;;
esac

# --- Validate OAuth login-screen config ---
# /oauth/authorize (a full authorization-code flow with dynamic client
# registration, as used by e.g. Claude.ai's "Add remote MCP server" UI)
# fails closed without oauth_password -- it's unrelated to
# mcp_auth_token/oauth_client_secret above, which only cover a bare bearer
# token or a pre-shared client_credentials grant. Not applicable (routes
# not mounted) in native Cloudflare Access mode.
cf_access_native_mode=false
if [ -n "${VAULT_MCP_CF_ACCESS_TEAM_DOMAIN}" ] && [ -n "${VAULT_MCP_CF_ACCESS_AUD}" ]; then
    cf_access_native_mode=true
fi
if [ "${cf_access_native_mode}" = false ] && [ -z "${VAULT_OAUTH_PASSWORD}" ]; then
    bashio::log.warning "oauth_password is empty -- a client doing a full OAuth authorization-code flow (e.g. Claude.ai's connector UI) will fail to log in at /oauth/authorize. Set oauth_password (and optionally oauth_username, default 'obsidian') if you need that flow."
fi

# --- Tailscale setup ---
if [ "${TUNNEL_MODE}" = "tailscale" ]; then
    if [ -z "${TAILSCALE_AUTH_KEY}" ]; then
        bashio::log.fatal "tailscale_auth_key is required when tunnel_mode is 'tailscale'."
        exec sleep inf
    fi

    bashio::log.info "Configuring Tailscale..."
    if ! command -v tailscale &>/dev/null; then
        apt-get install -y --no-install-recommends tailscale
    fi

    mkdir -p /data/tailscale
    tailscaled --tun=userspace-networking --state=/data/tailscale/state &
    sleep 2

    tailscale up \
        --authkey="${TAILSCALE_AUTH_KEY}" \
        --hostname="obsidian-mcp-ha" \
        --accept-routes=false \
        --ssh=false

    bashio::log.info "Tailscale up. MCP will be reachable on your tailnet."
fi

# --- TLS (direct HTTPS) ---
# obsidian-vault-mcp does not natively support TLS; for tunnel_mode=https
# the expectation is that an external reverse proxy (e.g. nginx via the HA
# nginx add-on) terminates TLS. We validate the cert/key exist so the
# operator gets a clear error if the paths are wrong.
if [ "${TUNNEL_MODE}" = "https" ]; then
    if [ ! -f "${TLS_CERT_PATH}" ] || [ ! -f "${TLS_KEY_PATH}" ]; then
        bashio::log.fatal "TLS cert/key not found at ${TLS_CERT_PATH} / ${TLS_KEY_PATH}."
        exec sleep inf
    fi
    bashio::log.info "TLS mode: proxy your reverse-proxy to http://localhost:${VAULT_MCP_PORT}"
fi

# --- Cloudflare Tunnel (config-only) ---
# This add-on does not run a cloudflared client itself — tunnel connectivity
# is managed by the separate cloudflared add-on, which should be configured
# to route its public hostname to http://localhost:${VAULT_MCP_PORT} inside
# this container's network namespace (or to this add-on's host:port from
# outside it, depending on how cloudflared is deployed). This mode only
# affects auth validation above; see DOCS.md for the recommended Cloudflare
# Access + identity provider setup in front of the tunnel, and for native
# Access JWT validation set cf_access_team_domain/cf_access_aud instead of
# relying on oauth_client_secret.
if [ "${TUNNEL_MODE}" = "cloudflare" ]; then
    bashio::log.info "Cloudflare tunnel mode: ensure the cloudflared add-on routes to http://localhost:${VAULT_MCP_PORT}"
fi

# --- Launch MCP server ---
# vault-mcp reads all configuration from environment variables (see build-env.sh).
# VAULT_PATH, VAULT_MCP_PORT, VAULT_MCP_TOKEN, VAULT_OAUTH_CLIENT_* are already exported.
#
# Invoked via `python3 <script>` rather than executing the script directly:
# pip bakes the builder stage's interpreter path into the shebang
# (python:3.12-slim uses /usr/local/bin/python3), which does not exist in the
# HA base image (apt installs Python at /usr/bin/python3). Calling the
# interpreter explicitly sidesteps the shebang entirely.
if ! command -v vault-mcp &>/dev/null; then
    bashio::log.fatal "vault-mcp binary not found — image may be corrupt. Rebuild the add-on."
    exec sleep inf
fi
exec python3 "$(command -v vault-mcp)"
